# Copy to .env for local runs. NEVER commit the real .env.
#
# One key per provider. The service decides the order itself (Gemini first,
# Groq as fallback), so there is no slot to put a key into wrongly.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides.
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b

LOG_LEVEL=INFO
PORT=8000

# Keep-alive (second layer against free-tier idle spin-down).
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_SECONDS=600
