# Copy to .env for local runs. NEVER commit the real .env.
# LLM provider settings are consumed in stage 5.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LOG_LEVEL=INFO
PORT=8000

# Keep-alive (second layer against free-tier idle spin-down).
# Set KEEPALIVE_URL to this service's own public /health URL.
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_SECONDS=600
